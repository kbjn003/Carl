# Local: `npx supabase start` prints these (use the "Publishable" / anon key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Forces the origin used in magic-link redirects.
# Leave unset locally and on Vercel previews; set to your production domain on Vercel prod.
# NEXT_PUBLIC_SITE_URL=https://carl.example.com

# Used from step 3 onwards (chat).
# ANTHROPIC_API_KEY=
